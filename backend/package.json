{
  "name": "kiday-academy-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node src/index.js",
    "seed": "node --env-file-if-exists=.env src/scripts/seed.js",
    "plan:set": "node --env-file-if-exists=.env src/scripts/set-plan.js",
    "db:inspect": "node --env-file-if-exists=.env src/scripts/db-inspect.js",
    "test": "node src/scripts/smoke-test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mongodb": "^6.20.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.0"
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true
  }
}
